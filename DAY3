import sys
class Queue:

    # constructor
    def __init__(self, queueSize):
        self.queueSize = queueSize
        self.myQueue = []

    # is full condition check
    def isFull(self):
        if len(self.myQueue) == self.queueSize:
            return True
        else:
            return False

    # is empty condition check
    def isEmpty(self):
        if self.myQueue == []:
            return True
        else:
            return False

    # Enqueue operation
    def enqueue(self, value):
        if self.isFull():
            print("Queue is Full")
        else:
            self.myQueue.append(value)
            print("Element inserted:", value)

    # Dequeue operation
    def dequeue(self):
        if self.isEmpty():
            print("Queue is Empty")
        else:
            value = self.myQueue.pop(0)
            print("Element deleted:", value)

    # Peek operation
    def peek(self):
        if self.isEmpty():
            print("Queue is Empty")
        else:
            print("Front element:", self.myQueue[0])

    # Delete queue
    def deleteQueue(self):
        self.myQueue = []
        print("Queue deleted")

    # Display queue
    def display(self):
        if self.isEmpty():
            print("Queue is Empty")
        else:
            print("Queue:", self.myQueue)

size = int(input("Enter the size of queue: "))
obj = Queue(size)

while True:
    print("\n1. Enqueue operation")
    print("2. Dequeue operation")
    print("3. Peek operation")
    print("4. isFull")
    print("5. isEmpty")
    print("6. Delete Entire Queue")
    print("7. Display Queue")
    print("8. Exit operation")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        value = int(input("Enter the value to insert in queue: "))
        obj.enqueue(value)

    elif choice == 2:
        obj.dequeue()

    elif choice == 3:
        obj.peek()

    elif choice == 4:
        if obj.isFull():
            print("Queue is Full")
        else:
            print("Queue is not Full")

    elif choice == 5:
        if obj.isEmpty():
            print("Queue is Empty")
        else:
            print("Queue is not Empty")

    elif choice == 6:
        obj.deleteQueue()

    elif choice == 7:
        obj.display()

    elif choice == 8:
        print("Exiting...")
        break

    else:
        print("Invalid choice")
