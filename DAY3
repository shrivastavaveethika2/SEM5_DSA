def largest_rectangular_area():
    # Read all inp
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    n = int(input_data[0])
    heights = [int(x) for x in input_data[1:n+1]]
    
    stack = []
    max_area = 0
    i = 0
    
    while i < n:
        # If stack is empty or current height is greater than or equal to stack top
        if not stack or heights[i] >= heights[stack[-1]]:
            stack.append(i)
            i += 1
        else:
            # Pop the top element
            top_of_stack = stack.pop()
            # Calculate area with heights[top_of_stack] as the smallest height
            width = i if not stack else i - stack[-1] - 1
            area = heights[top_of_stack] * width
            max_area = max(max_area, area)
            
    # Pop the remaining bars from the stack
    while stack:
        top_of_stack = stack.pop()
        width = i if not stack else i - stack[-1] - 1
        area = heights[top_of_stack] * width
        max_area = max(max_area, area)
        
    print(max_area)

if __name__ == '__main__':
    largest_rectangular_area()
