def isValid(s: str) -> bool:
 
    stack = []
    

    mapping = {")": "(", "}": "{", "]": "["}
    
    for char in s:
 
        if char in mapping:
            
            top_element = stack.pop() if stack else '#'
            
            if mapping[char] != top_element:
                return False
        else:
       
            stack.append(char)
            
    return not stack


if __name__ == "__main__":
    import sys
  
    input_string = sys.stdin.read().strip()

    if isValid(input_string):
        print("true")
    else:
        print("false")
