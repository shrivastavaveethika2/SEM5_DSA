class Node:
    def __init__(self, data):
        self.data = data
        self.children = []

    def addChild(self, node):
        self.children.append(node)

    def printTree(self, level=0):
        print(" " * (level * 4) + self.data)

        for child in self.children:
            child.printTree(level + 1)



