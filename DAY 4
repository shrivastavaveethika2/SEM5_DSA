class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None

    # 1. Insert at beginning
    def insert_beginning(self, data):
        new_node = Node(data)
        new_node.next = self.head
        self.head = new_node

    # 2. Insert in between
    def insert_between(self, data, position):
        new_node = Node(data)

        if position == 1:
            self.insert_beginning(data)
            return

        temp = self.head

        for i in range(1, position - 1):
            if temp is None:
                print("Position not found")
                return
            temp = temp.next

        if temp is None:
            print("Position not found")
            return

        new_node.next = temp.next
        temp.next = new_node

    # 3. Insert at end
    def insert_end(self, data):
        new_node = Node(data)

        if self.head is None:
            self.head = new_node
            return

        temp = self.head

        while temp.next is not None:
            temp = temp.next

        temp.next = new_node

    # 4. Delete
    def delete(self, data):
        if self.head is None:
            print("List is empty")
            return

        if self.head.data == data:
            self.head = self.head.next
            return

        temp = self.head

        while temp.next is not None:
            if temp.next.data == data:
                temp.next = temp.next.next
                return
            temp = temp.next

        print("Element not found")

    def display(self):
        temp = self.head

        while temp is not None:
            print(temp.data, end=" -> ")
            temp = temp.next

        print("None")


# Create linked list
ll = LinkedList()

ll.insert_beginning(10)
ll.insert_beginning(20)
ll.insert_end(40)
ll.insert_between(30, 3)

ll.display()

ll.delete(20)

ll.display()
