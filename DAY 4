import heapq

k = int(input())
heap = []

for i in range(k):
    data = list(map(int, input().split()))
    length = data[0]
    values = data[1:]

    if length > 0:
        heapq.heappush(heap, (values[0], i, 0, values))

result = []

while heap:
    value, playlist, index, values = heapq.heappop(heap)
    result.append(value)

    next_index = index + 1

    if next_index < len(values):
        heapq.heappush(heap, (values[next_index], playlist, next_index, values))

print(*result)
